# ==============================================================================
# ReportSetu Full Stack Environment Variables
# Copy to individual .env files or use with Docker Compose orchestration.
# ==============================================================================

# PostgreSQL Database
POSTGRES_USER=reportsetu
POSTGRES_PASSWORD=reportsetu
POSTGRES_DB=reportsetu
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reportsetu:reportsetu@localhost:5432/reportsetu?schema=public

# Backend API Service
PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LOG_LEVEL=info
SMS_DEV_CODE=123456

# Frontend Application
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Machine Learning Service
ML_PORT=8001
ML_SERVICE_URL=http://127.0.0.1:8001

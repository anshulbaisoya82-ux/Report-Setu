# ==============================================================================
# ReportSetu Frontend Environment Variables
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Backend REST API endpoint (Express server)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Real-time WebSocket / Socket.IO server URL
VITE_SOCKET_URL=http://localhost:5000

# Set to "true" to run on synthetic in-browser data with no backend (see .env.demo).
VITE_DEMO_MODE=false

# Medicine-name suggestions while prescribing. Set to "off" to disable them completely.
# VITE_MEDICINE_SEARCH=off
# Medicine-name suggestions come from the backend (GET /prescriptions/medicine-suggestions,
# which calls the ML service's /drug/suggest). If that is down, NLM RxTerms is used unless:
# VITE_MEDICINE_SEARCH_FALLBACK=off

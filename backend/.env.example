# ==============================================================================
# ReportSetu Backend Environment Variables
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://reportsetu:reportsetu@127.0.0.1:5432/reportsetu?schema=public

# Security & Authentication (Generate 32+ character random secrets for production)
JWT_ACCESS_SECRET=reportsetu_jwt_access_super_secret_key_32_characters_min
JWT_REFRESH_SECRET=reportsetu_jwt_refresh_super_secret_key_32_characters_min

# 32-byte hexadecimal key for field-level medical data encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Origin for CORS
CORS_ORIGIN=http://localhost:5173

# AI & Extraction Provider ('gemini' or 'mock')
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Microservice Integration
ML_SERVICE_URL=http://127.0.0.1:8001

# Logging & Testing
LOG_LEVEL=info
SMS_DEV_CODE=123456

# ==============================================================================
# ReportSetu ML Microservice Environment Variables
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# FastAPI service port
ML_PORT=8001

# Environment mode ('development' or 'production')
ML_ENV=development

# Logging verbosity ('debug', 'info', 'warning', 'error')
LOG_LEVEL=info

# Optional LLM API Key (if using external Gemini / OpenAI for summarization)
GEMINI_API_KEY=
